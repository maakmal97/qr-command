{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "qr-command",
	"main": "src/worker.js",
	// Do not raise this past what the installed workers runtime supports: wrangler 4.120.0
	// tops out at 2026-08-08 and refuses to start on anything later, locally and on deploy.
	"compatibility_date": "2026-08-08",

	// A Worker with static assets. public/ is the entire shipping surface and it is a build
	// output: tools/build.mjs writes it and refuses to finish if anything from the master's
	// private fields has leaked into it. Nothing outside public/ is deployed, which is why
	// the docs, the PDFs, the local server and the master's own store cannot ship by accident.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// NOT "single-page-application". That would answer a missing asset with index.html,
		// so a stale service worker asking for a file that no longer exists would be handed
		// HTML and cache it under a script URL.
		"not_found_handling": "none",
		// The Worker runs first on every request so it can set the security headers itself
		// rather than trusting a _headers file to be applied. X-Robots-Tag is the only thing
		// keeping this address out of a search index; it is not left to inference.
		"run_worker_first": true
	},

	// ONE KV NAMESPACE, AND THE WORKER ONLY EVER READS IT.
	//
	// The account list is still baked into the bundle at build time. This holds one thing the
	// bundle cannot: whether an account has been suspended since the last deploy, so a code
	// being changed on the laptop stops being shown on the phone within seconds instead of
	// within a deploy.
	//
	// IT DOES NOT REOPEN THE WRITE PATH. src/worker.js calls QR_STATE.get and nothing else;
	// there is no route that writes, no secret, no EDIT_KEY and nothing to authenticate,
	// which is the property the site was built around. The value is written from the laptop
	// through the Cloudflare API by wrangler, under the owner's own login. A stranger with
	// the address gains a JSON file listing account keys and booleans, and the keys are
	// already public in data.js.
	//
	// The baked flag remains the fail-safe. A phone with no signal cannot read this, so the
	// bundle still has to carry the truth, and the local toggle deploys as well as writing
	// here. KV is the fast path, never the only one.
	"kv_namespaces": [
		{
			"binding": "QR_STATE",
			"id": "5b09e99f07e147f09a88fc1325203ead"
		}
	],

	"observability": {
		"enabled": true
	}
}
