{
	"$schema": "node_modules/wrangler/config-schema.json",
	// DELIBERATELY MEANINGLESS, and line comments only: the suite strips `//` and nothing else,
	// so a block comment here fails "wrangler.jsonc parses once its comments are stripped".
	//
	// The Worker name is the first label of the public address, so it is a random string rather
	// than a description. The page is public by decision, and an unguessable address is the only
	// thing between it and somebody typing likely names. That is obscurity, not security, and it
	// is worth exactly what that is worth: anyone who has ever seen the URL still has it, and
	// X-Robots-Tag is what keeps it out of a search index.
	//
	// Renaming again is one edit and one deploy, plus deleting the Worker left behind, or the
	// old address keeps serving the codes.
	"name": "jb3zkzyqguu5",
	"main": "src/worker.js",
	// Do not raise this past what the installed workers runtime supports: wrangler 4.120.0
	// tops out at 2026-08-08 and refuses to start on anything later, locally and on deploy.
	"compatibility_date": "2026-08-08",
	// NO PREVIEW URLS (10 Oct 2026). A version's own workers.dev address would sit outside the
	// Access application, which covers /admin by hostname, so /admin there would skip the first
	// lock. Nothing reads one. Takes effect on the next `wrangler deploy`.
	"preview_urls": false,

	// A Worker with static assets. public/ is the entire shipping surface and it is a build
	// output: tools/build.mjs writes it and refuses to finish if anything from the master's
	// private fields has leaked into it. Nothing outside public/ is deployed, which is why
	// the docs, the PDFs, the local server and the master's own store cannot ship by accident.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// NOT "single-page-application". That would answer a missing asset with index.html,
		// so a stale service worker asking for a file that no longer exists would be handed
		// HTML and cache it under a script URL.
		"not_found_handling": "none",
		// The Worker runs first on every request so it can set the security headers itself
		// rather than trusting a _headers file to be applied. X-Robots-Tag is the only thing
		// keeping this address out of a search index; it is not left to inference.
		"run_worker_first": true
	},

	// ONE KV NAMESPACE, holding one value: which accounts are suspended and what order the
	// tiles stand in. The account list itself is still baked into the bundle at build time.
	//
	// THE ONE WRITE ROUTE, POST /api/state, exists since 8 Sep 2026 and is gated by Cloudflare
	// Access. The Worker verifies the Access JWT itself (signature against the team's public
	// keys, issuer, audience, expiry) on every gated request; a header alone is not trusted.
	// A stranger with the address still gains only /state.json: keys, booleans and an order,
	// and the keys are already public in data.js.
	//
	// THE TWO VARIABLES BELOW ARE THE GATE'S CONFIGURATION AND NEITHER IS A SECRET. Empty,
	// every gated route answers 401 and nothing is written, so a deploy before the Access
	// application exists is safe. ACCESS_TEAM is the first label of the team domain
	// (<team>.cloudflareaccess.com); ACCESS_AUD is the application's Audience tag from its
	// Overview tab in Zero Trust.
	"kv_namespaces": [
		{
			"binding": "QR_STATE",
			"id": "5b09e99f07e147f09a88fc1325203ead"
		}
	],
	"vars": {
		"ACCESS_TEAM": "maakmal",
		"ACCESS_AUD": "14a921e2b5c1ba14ca75026b930208093644ef349993a4fc66015f689060fecf",
		// A self-lifting guard: an ISO timestamp makes every request answer 503 until then.
		// Empty does nothing. Set at deploy with --var, never left set here.
		"MAINTENANCE_UNTIL": ""
	},

	"observability": {
		"enabled": true
	}
}
